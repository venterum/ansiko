<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_glyph" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/AnsikoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/accent"
                    android:textSize="16sp" />

                <TextView
                    style="@style/AnsikoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_subtitle"
                    android:textColor="@color/faint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/line" />

        <TextView
            android:id="@+id/status"
            style="@style/AnsikoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/endpoint"
            style="@style/AnsikoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/faint"
            android:textSize="11sp" />

        <TextView
            style="@style/AnsikoSection"
            android:text="@string/settings_section_server" />

        <TextView
            style="@style/AnsikoLabel"
            android:text="@string/settings_host" />

        <EditText
            android:id="@+id/host"
            style="@style/AnsikoField"
            android:hint="@string/settings_host_hint"
            android:inputType="textUri" />

        <TextView
            style="@style/AnsikoLabel"
            android:text="@string/settings_port" />

        <EditText
            android:id="@+id/port"
            style="@style/AnsikoField"
            android:hint="@string/settings_port_hint"
            android:inputType="number"
            android:maxLength="5" />

        <TextView
            style="@style/AnsikoLabel"
            android:text="@string/settings_token" />

        <EditText
            android:id="@+id/token"
            style="@style/AnsikoField"
            android:hint="@string/settings_token_hint"
            android:inputType="textVisiblePassword" />

        <TextView
            style="@style/AnsikoSection"
            android:text="@string/settings_section_screen" />

        <CheckBox
            android:id="@+id/drift"
            style="@style/AnsikoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:button="@null"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <CheckBox
            android:id="@+id/dim_night"
            style="@style/AnsikoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:button="@null"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/AnsikoText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_brightness"
                android:textColor="@color/faint"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/brightness_minus"
                style="@style/AnsikoStep"
                android:text="@string/settings_minus" />

            <TextView
                android:id="@+id/brightness_value"
                style="@style/AnsikoText"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/brightness_plus"
                style="@style/AnsikoStep"
                android:text="@string/settings_plus" />
        </LinearLayout>

        <TextView
            android:id="@+id/error"
            style="@style/AnsikoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/save"
            style="@style/AnsikoButton"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_accent"
            android:text="@string/settings_save"
            android:textColor="@color/accent_ink" />

        <TextView
            android:id="@+id/scan"
            style="@style/AnsikoButton"
            android:layout_marginTop="10dp"
            android:text="@string/settings_scan" />
    </LinearLayout>
</ScrollView>
